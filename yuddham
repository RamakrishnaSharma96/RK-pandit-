<title>Dwandva Yuddha</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Yatra+One&family=Mukta:wght@400;600;800&display=swap">
<style>
/* Layout: one full-screen duel arena canvas; twin health bars pinned top like a fighting game; move stick bottom-left, weapon grid bottom-right; marigold-toran panels float centred. Single dark look by choice. */
:root{
  --night:#0a0d24; --panel:#15133a;
  --kesari:#ff8a1f; --gold:#f5c451; --kumkum:#d7263d; --rama:#3b86f2;
  --parch:#f7ead0; --mute:#b9ad9a; --line:rgba(245,196,81,.35);
  --font-display:'Yatra One','Mukta','Noto Sans Devanagari',system-ui,sans-serif;
  --font-body:'Mukta','Noto Sans Devanagari',system-ui,-apple-system,'Segoe UI',sans-serif;
  color-scheme:dark;
}
html,body{height:100%}
body{background:var(--night);color:var(--parch);font-family:var(--font-body);font-size:16px;line-height:1.45;overflow:hidden;overscroll-behavior:none;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
#cv{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}

/* HUD */
#hud{position:fixed;inset:0 0 auto 0;pointer-events:none;display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:start;
  padding:calc(8px + env(safe-area-inset-top,0px)) max(12px,env(safe-area-inset-right,0px)) 0 max(12px,env(safe-area-inset-left,0px))}
.sd{min-width:0}
.sd b{display:block;font-family:var(--font-display);font-weight:400;font-size:19px;line-height:1.2;text-shadow:0 2px 6px #000;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sd.r{text-align:right}.sd.l b{color:#bfe0ff}.sd.r b{color:#ff9a9a}
.hb{height:15px;border-radius:3px;background:rgba(10,13,36,.8);border:1.5px solid var(--gold);overflow:hidden;transform:skewX(-14deg)}
.hb i{display:block;height:100%;width:100%}
#pH{background:linear-gradient(180deg,#9bd6ff,#3b86f2 55%,#1b4fb8)}
.sd.r .hb{border-color:#ff7a7a;transform:skewX(14deg)}
#eH{background:linear-gradient(180deg,#ff8a8a,#d7263d 55%,#7a0d1c);margin-left:auto}
.tj{height:8px;margin-top:4px;border-radius:2px;background:rgba(10,13,36,.8);border:1px solid var(--line);overflow:hidden;transform:skewX(-14deg);width:86%;position:relative}
#pT{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--kesari),#fff3c4)}
.tj::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 39.5%,#0a0d24 39.5% 40.5%,transparent 40.5% 69.5%,#0a0d24 69.5% 70.5%,transparent 70.5%)}
.tl{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);text-shadow:0 1px 3px #000}
.mid{display:grid;justify-items:center;gap:4px}
#clk{font-family:var(--font-display);font-size:22px;color:var(--gold);text-shadow:0 2px 6px #000;font-variant-numeric:tabular-nums}
.ibs{display:flex;gap:6px}
.ib{pointer-events:auto;width:34px;height:34px;border-radius:50%;background:rgba(10,13,36,.75);border:1px solid var(--line);font-weight:800;font-size:13px}

/* Weapon grid */
#pad{position:fixed;right:calc(10px + env(safe-area-inset-right,0px));bottom:calc(12px + env(safe-area-inset-bottom,0px));
  display:grid;grid-template-columns:repeat(4,54px);gap:6px;pointer-events:none}
.kb{pointer-events:auto;touch-action:none;width:54px;height:54px;border-radius:50%;padding:0;display:grid;place-items:center;
  background:conic-gradient(var(--kc,var(--kesari)) var(--p,100%),rgba(10,13,36,.85) 0);border:1.5px solid var(--line)}
.kb span{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;text-align:center;background:var(--night);
  font-family:var(--font-display);font-size:13.5px;line-height:1.05;color:var(--mute)}
.kb.ready{border-color:var(--kc,var(--gold))}
.kb.ready span{color:#160a02;background:radial-gradient(circle at 50% 35%,#fff,var(--kc,var(--gold)) 62%)}
.kb.hint{animation:hint .35s ease-in-out infinite alternate}
@keyframes hint{to{box-shadow:0 0 0 6px rgba(255,255,255,.55),0 0 26px var(--kc);transform:scale(1.12)}}
#as8.ready{animation:pulse 1s ease-in-out infinite}
@keyframes pulse{50%{box-shadow:0 0 0 8px rgba(255,138,31,.3),0 0 28px rgba(255,243,196,.9)}}
#kA span{font-size:17px}

/* Banner + katha */
#bn{position:fixed;left:0;right:0;top:15%;text-align:center;pointer-events:none;opacity:0;padding:0 16px}
#bnH{font-family:var(--font-display);font-size:clamp(32px,10vw,72px);line-height:1.15;color:var(--gold);
  text-shadow:0 0 18px rgba(255,138,31,.9),0 3px 0 #7a3b06,0 6px 18px #000;text-wrap:balance}
#bnS{font-weight:800;letter-spacing:.12em;text-transform:uppercase;font-size:14px;color:var(--parch);text-shadow:0 2px 6px #000}
#bn.show{animation:chant 2.2s ease-out forwards}
@keyframes chant{0%{opacity:0;transform:scale(.6)}10%{opacity:1;transform:scale(1.08)}18%{transform:scale(1)}78%{opacity:1}100%{opacity:0;transform:translateY(-18px)}}
#katha{position:fixed;left:max(16px,env(safe-area-inset-left,0px));right:max(16px,env(safe-area-inset-right,0px));bottom:calc(206px + env(safe-area-inset-bottom,0px));
  pointer-events:none;font-size:15px;font-weight:600;color:var(--parch);text-shadow:0 2px 6px #000,0 0 2px #000;opacity:0;transition:opacity .6s;max-width:560px}
#katha.show{opacity:1}

/* Panels */
.ov{position:fixed;inset:0;display:flex;overflow-y:auto;background:rgba(6,8,24,.62);
  padding:calc(20px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) calc(20px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.pn{margin:auto;width:100%;max-width:480px;background:rgba(21,19,58,.94);border:1px solid var(--line);border-radius:6px 6px 18px 18px;
  padding:34px 18px 22px;text-align:center;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.6)}
.pn::before{content:"";position:absolute;left:0;right:0;top:0;height:18px;border-radius:6px 6px 0 0;
  background:radial-gradient(circle at 50% 0,var(--kesari) 0 7px,transparent 8px) 0 0/18px 18px repeat-x,
             radial-gradient(circle at 50% 0,var(--gold) 0 7px,transparent 8px) 9px 4px/18px 18px repeat-x,#3d1a52}
.eye{font-weight:800;letter-spacing:.16em;text-transform:uppercase;font-size:12px;color:var(--kesari)}
h1{font-family:var(--font-display);font-weight:400;font-size:clamp(42px,12vw,64px);line-height:1.05;margin:4px 0 0;color:var(--gold);
  text-shadow:0 3px 0 #7a3b06,0 0 26px rgba(255,138,31,.55)}
h2{font-family:var(--font-display);font-weight:400;font-size:30px;margin:0 0 4px;color:var(--gold);text-wrap:balance}
h3{margin:0;font-family:var(--font-display);font-weight:400;font-size:20px;color:var(--gold);text-align:left}
.sub{font-size:15px;color:var(--parch);margin:6px 0 0}
p{margin:12px 0}
.go{display:block;width:100%;margin-top:14px;padding:14px 18px;border-radius:999px;font-family:var(--font-display);font-size:22px;color:#2a1203;
  background:linear-gradient(180deg,#ffd27a,var(--kesari));box-shadow:0 4px 0 #9a4a05,0 10px 24px rgba(255,138,31,.35)}
.go:active{transform:translateY(3px);box-shadow:0 1px 0 #9a4a05}
.gh{display:block;width:100%;margin-top:10px;padding:11px 18px;border-radius:999px;border:1px solid var(--line);font-weight:800;color:var(--parch)}
.foes{display:grid;gap:7px;margin-top:14px}
.fo{display:flex;gap:10px;align-items:center;text-align:left;padding:9px 12px;border-radius:12px;background:rgba(10,13,36,.6);border:1px solid rgba(255,255,255,.12);min-width:0}
.fo div{flex:1;min-width:0}
.fo b{display:block;font-family:var(--font-display);font-weight:400;font-size:20px;color:var(--parch);line-height:1.2}
.fo em{display:block;font-style:normal;font-size:12.5px;color:var(--mute)}
.fo i{flex:none;font-style:normal;font-weight:800;font-size:13px;color:var(--gold);font-variant-numeric:tabular-nums;text-align:right}
.fo.on{border-color:var(--gold);background:rgba(255,138,31,.16)}.fo.on b{color:var(--gold)}
.fo:disabled{opacity:.45;cursor:default}
.sec{margin-top:16px;border-top:1px solid var(--line);padding-top:12px;text-align:left}
.how{margin:8px 0 0;padding:0;list-style:none;display:grid;gap:5px;font-size:14.5px}
.how li{padding-left:18px;position:relative}
.how li::before{content:"";position:absolute;left:2px;top:.55em;width:7px;height:7px;background:var(--kesari);transform:rotate(45deg)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0 4px}
.stats div{background:rgba(10,13,36,.6);border-radius:10px;padding:8px 4px;min-width:0}
.stats b{display:block;font-family:var(--font-display);font-weight:400;font-size:24px;color:var(--gold);font-variant-numeric:tabular-nums}
.stats span{font-size:12px;color:var(--mute);font-weight:600}
#tier{font-size:13px;font-weight:800;color:var(--gold);margin:8px 0 0}
@media (prefers-reduced-motion:reduce){#bn.show{animation:chantR 2.2s linear forwards}.kb.hint,#as8.ready{animation:none}
  @keyframes chantR{0%,80%{opacity:1}100%{opacity:0}}}
</style>
</head>
<body>

<canvas id="cv" aria-label="Duel arena"></canvas>

<div id="hud" hidden>
  <div class="sd l"><b>श्री राम</b><div class="hb"><i id="pH"></i></div><div class="tj"><i id="pT"></i></div><span class="tl">तेज · Tejas</span></div>
  <div class="mid"><span id="clk">0:00</span><div class="ibs"><button class="ib" id="bSnd" aria-label="Sound on or off">♪</button><button class="ib" id="bPause" aria-label="Pause">II</button></div></div>
  <div class="sd r"><b id="eN"></b><div class="hb"><i id="eH"></i></div></div>
</div>
<div id="pad" hidden></div>
<div id="bn" aria-live="polite"><div id="bnH"></div><div id="bnS"></div></div>
<div id="katha"></div>

<div class="ov" id="menu">
  <div class="pn">
    <div class="eye">Rama against the rakshasas, one on one</div>
    <h1>द्वन्द्व युद्ध</h1>
    <p class="sub">Dwandva Yuddha · seven astra duels from the Ramayana</p>
    <p id="tier"></p>
    <div class="foes" id="foes"></div>
    <button class="go" id="bPlay">जय श्री राम · Fight</button>
    <div class="sec">
      <h3>How to fight</h3>
      <ul class="how">
        <li><b>Left thumb:</b> drag to move. Push up to jump, pull down to guard.</li>
        <li><b>Right thumb:</b> hold <b>बाण</b> to shoot, <b>खड्ग</b> to slash, <b>वेग</b> to dash.</li>
        <li><b>One astra at a time.</b> After any astra, all of them recharge together for about two seconds. Choose: attack, or keep one ready to answer his.</li>
        <li><b>Answer his astra:</b> Varuna drowns Agni, Garuda devours the serpents, Surya burns away darkness, Vayu scatters the storm cloud. The right button flashes.</li>
        <li><b>नारायण, पाशुपत, ब्रह्म</b> spend Tejas (40, 70, all of it). Tejas fills as you land hits and cut his astras.</li>
        <li>Keyboard: A/D move, W jump, S guard, J arrow, K sword, L dash, 1 to 9 astras.</li>
      </ul>
    </div>
  </div>
</div>

<div class="ov" id="pause" hidden>
  <div class="pn">
    <div class="eye">Paused</div>
    <h2>श्री राम जय राम जय जय राम</h2>
    <button class="go" id="bResume">Return to the duel</button>
    <button class="gh" id="bQuit">Choose another opponent</button>
  </div>
</div>

<div class="ov" id="end" hidden>
  <div class="pn">
    <div class="eye" id="eEye"></div>
    <h2 id="eH2"></h2>
    <p id="eP"></p>
    <div class="stats">
      <div><b id="sT">0:00</b><span>Time</span></div>
      <div><b id="sC">0</b><span>Astras cut</span></div>
      <div><b id="sH">0%</b><span>Health left</span></div>
    </div>
    <button class="go" id="bNext"></button>
    <button class="gh" id="bHome">Choose opponent</button>
  </div>
</div>

<script>
(()=>{
'use strict';
const $=id=>document.getElementById(id), TAU=Math.PI*2, PI=Math.PI, R=Math.random;
const cv=$('cv'), cx=cv.getContext('2d');let K=cx;
const RM=window.matchMedia&&matchMedia('(prefers-reduced-motion:reduce)').matches;
const ARW=480, ACD=2.2;
let W=0,H=0,DPR=1,state='menu',last=0,sel=0,G=null,P=null,E=null,BG=null,groundY=0,sc=.5,cam=0,shx=0,shy=0;

/* ---------- save ---------- */
const KEY='dwandvaYuddha.v1';
let save={done:0,best:[],stars:[],tier:0};
try{const s=JSON.parse(localStorage.getItem(KEY));if(s){save=Object.assign(save,s);if(!Array.isArray(save.best))save.best=[];if(!Array.isArray(save.stars))save.stars=[];save.tier=save.tier||0;}}catch(e){}
function persist(){try{localStorage.setItem(KEY,JSON.stringify(save));}catch(e){}}

/* ---------- audio ---------- */
let AC=null,master=null,soundOn=true,nbuf=null,lastSfx=0,lastSay=0;
function initAudio(){
  if(AC){if(AC.state==='suspended')AC.resume();return;}
  try{AC=new (window.AudioContext||window.webkitAudioContext)();master=AC.createGain();master.gain.value=soundOn?.6:0;master.connect(AC.destination);
    const f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=420;const g=AC.createGain();g.gain.value=.045;f.connect(g);g.connect(master);
    [98,146.83,196.2].forEach(fr=>{const o=AC.createOscillator();o.type='sawtooth';o.frequency.value=fr;o.connect(f);o.start();});
  }catch(e){AC=null;}
}
function tone(f,d,type,v,f2,delay){if(!AC)return;const t=AC.currentTime+(delay||0),o=AC.createOscillator(),g=AC.createGain();
  o.type=type||'sine';o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+d);
  g.gain.setValueAtTime(.0001,t);g.gain.linearRampToValueAtTime(v,t+.012);g.gain.exponentialRampToValueAtTime(.0001,t+d);
  o.connect(g);g.connect(master);o.start(t);o.stop(t+d+.05);}
function noise(d,v,fq){if(!AC)return;if(!nbuf){nbuf=AC.createBuffer(1,AC.sampleRate,AC.sampleRate);const a=nbuf.getChannelData(0);for(let i=0;i<a.length;i++)a[i]=R()*2-1;}
  const s=AC.createBufferSource(),g=AC.createGain(),f=AC.createBiquadFilter(),t=AC.currentTime;s.buffer=nbuf;s.loop=true;f.type='bandpass';f.frequency.value=fq;
  g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);s.connect(f);f.connect(g);g.connect(master);s.start(t);s.stop(t+d);}
function shankha(len){if(!AC)return;len=len||1.7;const t=AC.currentTime,f=AC.createBiquadFilter(),g=AC.createGain();f.type='lowpass';f.frequency.value=1100;
  g.gain.setValueAtTime(.0001,t);g.gain.linearRampToValueAtTime(.17,t+.25);g.gain.setValueAtTime(.17,t+len-.45);g.gain.exponentialRampToValueAtTime(.0001,t+len);
  f.connect(g);g.connect(master);
  [1,2,3].forEach((m,i)=>{const o=AC.createOscillator(),og=AC.createGain();o.type=i?'sine':'sawtooth';o.frequency.setValueAtTime(150*m,t);
    o.frequency.exponentialRampToValueAtTime(233*m,t+.3);og.gain.value=i?.5:.6;o.connect(og);og.connect(f);o.start(t);o.stop(t+len+.05);});}
function bell(){[523.25,1046.5,1568,2093].forEach((f,i)=>tone(f,1.7-i*.3,'sine',.15/(i+1)));}
function drum(v,hi){tone(hi?150:105,.2,'sine',v,hi?70:44);}
function boom(v){tone(90,.6,'sine',v||.3,30);noise(.5,(v||.3)*.6,120);}
function clang(){tone(1800,.12,'square',.05,900);noise(.08,.1,3000);}
function growl(v,len,f0){if(!AC)return;const t=AC.currentTime,o=AC.createOscillator(),am=AC.createOscillator(),ag=AC.createGain(),tg=AC.createGain(),g=AC.createGain(),f=AC.createBiquadFilter();
  f0=f0||85;o.type='sawtooth';o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(f0*.55,t+len);
  am.type='square';am.frequency.value=27;ag.gain.value=.45;tg.gain.value=.55;am.connect(ag);ag.connect(tg.gain);
  f.type='lowpass';f.frequency.value=650;g.gain.setValueAtTime(.0001,t);g.gain.linearRampToValueAtTime(v,t+.05);g.gain.exponentialRampToValueAtTime(.0001,t+len);
  o.connect(f);f.connect(tg);tg.connect(g);g.connect(master);o.start(t);am.start(t);o.stop(t+len+.05);am.stop(t+len+.05);}
function laugh(){for(let i=0;i<6;i++)tone(190-i*14,.16,'sawtooth',.1,120-i*8,i*.17);growl(.16,1.3,58);}
function sfx(fn){const n=performance.now();if(n-lastSfx>45){lastSfx=n;fn();}}
function say(t,pri){if(!soundOn)return;const n=performance.now();if(!pri&&n-lastSay<2200)return;lastSay=n;
  try{const ss=window.speechSynthesis;if(!ss)return;const u=new SpeechSynthesisUtterance(t);u.lang='hi-IN';u.rate=.9;u.pitch=.85;u.volume=1;
    const v=(ss.getVoices()||[]).find(x=>/^hi/i.test(x.lang));if(v)u.voice=v;ss.cancel();ss.speak(u);}catch(e){}}
const JSR='जय श्री राम',HHM='हर हर महादेव';
function banner(h,s){$('bnH').textContent=h;$('bnS').textContent=s||'';const el=$('bn');el.classList.remove('show');void el.offsetWidth;el.classList.add('show');}
let kT=0;
function katha(t){const el=$('katha');el.textContent=t;el.classList.add('show');clearTimeout(kT);kT=setTimeout(()=>el.classList.remove('show'),5600);}

/* ---------- data ---------- */
const RSK=['#12409f','#3b86f2','#b9e4ff'],RSKB=['#0c2d78','#2a69cc','#7fbcf5'],GOLD=['#8a5408','#f2b824','#fff0a8'],DHO=['#b06d0a','#f6c22e','#fff2a6'],BONE='#efe5c8';
const ORN=['#5a3d08','#c9972e','#ffe08a'];
const rsk=rim=>({sk:['#040406','#1b1922',rim],skb:['#020203','#111017','#2c2936']});
const FOES=[
 Object.assign({id:'tataka',n:'ताटका',e:'Tataka',tag:'Yakshini with the strength of a thousand elephants',hp:520,scale:1.18,acc:'#7fae3a',cl:['#1f3a12','#4f8a2a','#a8d86a'],eye:'#ffd23f',w:'trunk',hair:1,skulls:1,spd:130,pref:400,think:1.25,dmg:20,reach:150,armor:0,
  moves:['rock','rock','tamas','charge','leap','melee','shila','rock'],arena:0,intro:'She hides in dust and darkness and rains down rocks. Answer the dark with the Sun.',win:'Tataka falls, and the forest she laid waste breathes again.'},rsk('#5d7a4a')),
 Object.assign({id:'subahu',n:'सुबाहु',e:'Subahu',tag:'Defiler of yajnas',hp:600,scale:1.12,acc:'#e0452f',cl:['#4a0d0a','#b02a1c','#ff8a6a'],eye:'#ff3b3b',w:'mace',spd:150,pref:420,think:1.2,dmg:22,reach:150,armor:.1,
  moves:['agni','megha','volley','agni','charge','melee','megha'],arena:1,intro:'He rains fire and storm on the altar. Drown his fire with Varuna.',win:'Subahu burns in the Agneyastra. The yajna fire stands unbroken.'},rsk('#7a4a44')),
