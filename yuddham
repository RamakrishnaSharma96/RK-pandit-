      {const m=G.ef.find(q=>q.k==='megha');if(m){m.t=m.dur;cut(m.x,330,'मेघ बिखर गए');spark(m.x,380,'#9aa0c8',26,420);}}break;
    case 'garuda':pr.push({o:0,k:'garuda',x:x0,h:h0+10,vx:f*520,vh:0,d:a.d,r:64,as:1});tone(2300,.5,'sawtooth',.07,1100);tone(1700,.5,'sawtooth',.05,900,.08);
      if(p.bound>0){p.bound=0;cut(p.x,150,'नागपाश टूटा');}break;
    case 'brahma':pr.push({o:0,k:'brahma',x:x0,h:h0,vx:f*950,vh:0,d:a.d,r:54,as:2});boom(.35);G.flash=.35;G.flashC='255,244,214';G.shake=.4;break;
