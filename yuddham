/* ---------- main update ---------- */
function update(rdt){
  if(G.stop>0){G.stop-=rdt;return;}
  const ch=P.st==='cast'&&AS[P.ai].k==='brahma'&&P.t<P.rel,dt=rdt*G.slow*(ch?.5:1);G.t+=dt;G.pt+=rdt;
  if(G.ph==='intro'){if(!G.intro2&&G.pt>.3){G.intro2=true;banner('श्री राम  ⚔  '+G.D.n,G.D.tag);katha(G.D.intro);growl(.14,1,70);}
    if(G.pt>2.5){G.ph='fight';G.pt=0;G.t=0;banner(JSR,'युद्ध आरम्भ · The duel begins');say(JSR,true);shankha(1.3);}}
  if(G.ph==='ko'&&G.pt>3.1){endFight();return;}
  if(G.ph==='ko'&&G.pt>1.3)G.slow=Math.min(1,G.slow+rdt);
  updP(dt);updE(dt);
  if(G.ph==='fight'&&!E.vanish&&P.st!=='dash'&&!(E.st==='act'&&(E.mv==='charge'||E.mv==='leap'))&&P.z<90&&E.z<60){const dx=P.x-E.x,min=46+22*E.def.scale;
    if(Math.abs(dx)<min){const s=Math.sign(dx)||-1,o=min-Math.abs(dx);P.x+=s*o*.8;E.x-=s*o*.2;P.x=Math.max(-ARW,Math.min(ARW,P.x));E.x=Math.max(-ARW,Math.min(ARW,E.x));}}
  updPr(dt);updEf(dt);
  if(G.dark>0){G.dark-=dt;G.darkIn=Math.min(1,G.darkIn+dt*2);}
  if(G.rainT>0)G.rainT-=dt;if(G.windT>0)G.windT-=dt;
  const dimT=G.ef.some(q=>q.k==='pashu'&&q.t<1.2)?.6:ch?.55:G.ef.some(q=>q.k==='vajra')?.35:G.ef.some(q=>q.k==='nara'||q.k==='bblast')?.25:0;G.dim+=(dimT-G.dim)*Math.min(1,rdt*6);
  if(G.shake>0)G.shake-=rdt;if(G.flash>0)G.flash-=rdt;if(G.zoomK>0)G.zoomK=Math.max(0,G.zoomK-rdt*.3);
  for(let i=G.fx.length-1;i>=0;i--){const f=G.fx[i];f.l-=dt;if(f.k===0){f.x+=f.vx*dt;f.h+=f.vh*dt;f.vh-=500*dt;}if(f.l<=0)G.fx.splice(i,1);}
  for(let i=G.tx.length-1;i>=0;i--){const x=G.tx[i];x.l-=dt;x.h+=42*dt;if(x.l<=0)G.tx.splice(i,1);}
  G.beat-=rdt;if(G.beat<=0&&G.ph==='fight'){G.bn=(G.bn||0)+1;drum(G.bn%4===0?.13:.05,G.bn%4===2);G.beat=E.hp<E.max*.4?.3:.48;}
  poseStep(P,dt);poseStep(E,dt);
  const mid=(P.x+E.x)/2,vw=Math.max(520,Math.abs(P.x-E.x)+250),ts=Math.min(W/vw,(groundY-78)/Math.max(245,E.def.scale*222));
  cam+=(mid-cam)*Math.min(1,rdt*5);sc+=(ts-sc)*Math.min(1,rdt*4);
}

/* ---------- poses ---------- */
function poseT(f){const D=f.def,s=f.st,u=f.t,o=idlePose(D.rama);
  if(f.z>0){o.tA=.95;o.kA=1.3;o.tB=-.15;o.kB=.9;o.lean=.1;}
  else if(f.moving){const ph=f.walk*(D.rama?9.5:8);o.tA=Math.sin(ph)*.55;o.tB=-Math.sin(ph)*.55;o.kA=.15+Math.max(0,Math.cos(ph))*.75;o.kB=.15+Math.max(0,-Math.cos(ph))*.75;o.lean+=.09*f.mdir;}
  if(D.rama){
    if(s==='shoot'||s==='cast'){const d=u<f.rel;Object.assign(o,{lean:-.06,fa:1.57,fe:0,ba:-1.25,be:d?3.2:2.5,draw:d?1:0,bF:1});
      if(f.z===0&&!f.moving){o.tA=.5;o.tB=-.45;o.kA=.12;o.kB=.2;}
