  else if(k==='agni'){G.pr.push({o:1,k,x:x0,h:135,vx:f*420,vh:0,d:D.dmg*1.1,r:30,as:1,tr:[]});noise(.7,.14,200);}
  else if(k==='naga'){[[45,360,0],[110,410,2],[178,335,4]].forEach(v=>G.pr.push({o:1,k,x:x0,h:v[0],vx:f*v[1],vh:0,d:D.dmg*.6,r:26,as:1,ph:v[2]}));noise(1,.12,5200);}
  else if(k==='shula'){G.pr.push({o:1,k,x:x0,h:125,vx:f*540,vh:0,d:D.dmg*1.15,r:26});noise(.4,.16,400);}
  else if(k==='arrow')G.pr.push({o:1,k,x:x0,h:n%2?60:140,vx:f*640,vh:0,d:D.dmg*.5,r:10});
  if(k==='rock'||k==='arrow')sfx(()=>noise(.25,.12,k==='rock'?300:700));}
function choose(){const e=E,D=e.def,dist=Math.abs(P.x-e.x),near=dist<D.reach+30;
  let pool=D.moves.filter(m=>{const v=MV[m];if(v.rage&&e.hp>e.max*.6)return false;if(m==='tamas'&&G.dark>0)return false;
    if(m==='megha'&&G.ef.some(q=>q.k==='megha'))return false;if((m==='rain'||m==='shila')&&G.ef.some(q=>q.k==='rain'))return false;return v.any||(near?v.near:v.far);});
  if(!pool.length)pool=['melee'];
  let m=pool[Math.floor(R()*pool.length)];if(m===e.lastM&&pool.length>1)m=pool[(pool.indexOf(m)+1)%pool.length];e.lastM=m;
  e.mv=m;e.st='wind';e.t=0;e.face=Math.sign(P.x-e.x)||1;e.vn=0;e.hitDone=false;
  const a=EA[m];if(a){float(e.x,235*D.scale,a.n+(a.c!==undefined?' → '+AS[a.c].s:''),'#ffb0a0',19,1);growl(.12,.8,65);tone(70,.8,'sawtooth',.05,140);}
  else if(m==='charge'||m==='slam'||m==='leap')growl(.14,.7,60);else if(R()<.4)growl(.08,.4,90);
  if(m==='leap'){e.lx0=e.x;}}
function slamFx(x){const D=E.def;G.shake=.6;boom(.35);ring(x,0,180,'255,120,90',.45);spark(x,10,'#c9a070',16,320);
  G.pr.push({o:1,k:'wave',x:x+60,h:0,vx:540,vh:0,d:D.dmg*.75,r:26,l:.9});G.pr.push({o:1,k:'wave',x:x-60,h:0,vx:-540,vh:0,d:D.dmg*.75,r:26,l:.9});}
function onAct(m){const e=E,D=e.def,p=P,dist=Math.abs(p.x-e.x);
  if(m==='melee'){sfx(()=>noise(.2,.18,500));if(dist<D.reach&&p.z<95)hitP(D.dmg,e.face,e.x);}
  else if(m==='rock'||m==='agni'||m==='naga'||m==='shula')eFire(m,0);
  else if(m==='tamas'){G.dark=6.5;G.darkIn=0;tone(55,1.6,'sawtooth',.12,40);noise(1.2,.1,150);banner('तामसास्त्र','Darkness · answer with सूर्य');}
  else if(m==='megha'){G.ef.push({k:'megha',t:0,dur:5,x:p.x,nt:1,lock:false,lx:0,d:D.dmg*.6});noise(1.2,.12,180);}
  else if(m==='rain'||m==='shila'){G.ef.push({k:'rain',t:0,dur:3.4,nt:.1,rock:m==='shila',d:D.dmg*.8});laugh();banner(EA[m].n,m==='shila'?'A rain of rocks · keep moving':'A rain of weapons · keep moving');}
  else if(m==='slam'){slamFx(e.x+e.face*60);if(dist<130&&p.z<30)hitP(D.dmg,e.face,e.x);}
  else if(m==='leap'){e.lx0=e.x;e.ltx=Math.max(-ARW,Math.min(ARW,p.x));sfx(()=>noise(.4,.16,260));}
  else if(m==='tele'){e.vanish=true;spark(e.x,130,D.acc,18,300);tone(900,.25,'sine',.08,200);}
  else if(m==='charge')sfx(()=>noise(.4,.16,260));}
function updE(dt){const e=E,D=e.def,p=P;e.t+=dt;if(e.flash>0)e.flash-=dt;if(e.sta>0)e.sta-=dt;
  const dx=p.x-e.x,dist=Math.abs(dx),dir=Math.sign(dx)||1,rage=(e.hp<e.max*.4?1.3:1)*G.th,sl=e.slow>0?.55:1;
  if(e.slow>0)e.slow-=dt;
  if(e.burn>0){e.burn-=dt;e.hp-=10*dt;if(R()<dt*8)spark(e.x+(R()-.5)*40,60+R()*120*D.scale,'#ff8a1f',1,90);if(e.hp<=0)e.hp=1;}
  e.moving=false;const leaping=e.st==='act'&&e.mv==='leap';
  if(G.ph!=='fight'){if(e.st!=='ko')e.st='idle';}
  else switch(e.st){
    case 'idle':{e.face=dir;let mv=0;if(dist>D.pref+50)mv=1;else if(dist<D.pref-110&&Math.abs(e.x)<ARW-20)mv=-.75;
      if(mv){e.x+=dir*mv*D.spd*sl*dt;e.moving=true;e.mdir=mv>0?1:-1;e.walk+=dt*sl;}
      e.think-=dt*rage*sl;if(e.think<=0)choose();break;}
    case 'wind':{const m=MV[e.mv];if(e.t>=m.w/Math.min(rage,1.3)){e.st='act';e.t=0;onAct(e.mv);}break;}
    case 'act':{const m=MV[e.mv];
      if(e.mv==='charge'){e.x+=e.face*760*dt;e.walk+=dt*2;if(!e.hitDone&&Math.abs(p.x-e.x)<62&&p.z<75&&p.inv<=0){e.hitDone=true;const g=p.st==='guard';hitP(D.dmg*(g?1.75:1.2),e.face,e.x);}
        if(Math.abs(e.x)>=ARW||(e.x-p.x)*e.face>160)e.t=m.a;}
      else if(e.mv==='leap'){const u=Math.min(1,e.t/m.a);e.x=e.lx0+(e.ltx-e.lx0)*u;e.z=Math.sin(PI*u)*280;}
      else if(e.mv==='volley'){if(e.vn<3&&e.t>=e.vn*.2){eFire('arrow',e.vn+(e.lastV||0));e.vn++;if(e.vn===3)e.lastV=(e.lastV||0)+1;}}
      if(e.t>=m.a){
        if(e.mv==='leap'){e.z=0;e.vz=0;slamFx(e.x);if(Math.abs(p.x-e.x)<120&&p.z<40)hitP(D.dmg*1.2,Math.sign(p.x-e.x)||1,e.x);e.st='rec';e.t=0;}
        else if(e.mv==='tele'){e.x=Math.max(-ARW,Math.min(ARW,p.x-p.face*125));e.vanish=false;e.face=Math.sign(p.x-e.x)||1;spark(e.x,130,D.acc,18,300);e.mv='melee';e.st='wind';e.t=.17;}
        else{e.st='rec';e.t=0;}}
      break;}
    case 'rec':if(e.t>=MV[e.mv].r){e.st='idle';e.think=D.think*(.6+R()*.6);}break;
    case 'stag':if(e.t>=e.sd){e.st='idle';e.think=Math.min(e.think,.5)+.25;}break;
  }
  if(!leaping&&(e.z>0||e.vz>0)){e.vz-=1900*dt;e.z+=e.vz*dt;if(e.z<=0){e.z=0;e.vz=0;}}
  e.x+=e.vx*dt;e.vx-=e.vx*Math.min(1,dt*7);
  e.x=Math.max(-ARW,Math.min(ARW,e.x));
  if(e.st==='ko'&&e.fall<1)e.fall=Math.min(1,e.fall+dt*1.5);
}

/* ---------- projectiles ---------- */
function updPr(dt){const pr=G.pr,p=P,e=E,S=e.def.scale;
  for(const q of pr){q.x+=q.vx*dt;if(q.g){q.vh-=q.g*dt;q.sp+=dt*6;}q.h+=q.vh*dt;if(q.l!==undefined){q.l-=dt;if(q.l<=0)q.dead=true;}
    if(Math.abs(q.x)>ARW+520)q.dead=true;if(q.g&&q.h<=0){q.dead=true;spark(q.x,10,'#8a8f98',8,200);ring(q.x,0,60,'150,150,150',.3);}
    if(q.tr){q.tr.unshift(q.x,q.h);if(q.tr.length>26)q.tr.length=26;}
    if(q.k==='garuda'&&R()<dt*22)G.fx.push({k:0,x:q.x-Math.sign(q.vx)*40,h:q.h+(R()-.5)*60,vx:-q.vx*.2,vh:60,l:.6,ml:.6,c:'#ffd27a',s:5});
    if(q.k==='varuna'&&R()<dt*40)G.fx.push({k:0,x:q.x+(R()-.5)*60,h:150+R()*80,vx:-q.vx*.3+(R()-.5)*120,vh:160,l:.5,ml:.5,c:'#dff6ff',s:4});
    if(q.k==='brahma'&&R()<dt*50)G.fx.push({k:0,x:q.x,h:q.h+(R()-.5)*50,vx:-q.vx*.15,vh:(R()-.5)*160,l:.4,ml:.4,c:'#fff3c4',s:5});
    if(q.k==='naga'&&R()<dt*10)G.fx.push({k:0,x:q.x,h:q.h,vx:0,vh:-40,l:.5,ml:.5,c:'#8be06a',s:4});}
  // astra against astra
  for(const a of pr){if(a.o!==0||a.dead)continue;for(const b of pr){if(b.o!==1||b.dead||b.k==='wave')continue;
    if(Math.abs(a.x-b.x)>=a.r+b.r)continue;const mh=(a.h+b.h)/2,light=b.k==='rock'||b.k==='arrow'||b.k==='shula';
    if(a.as===2){b.dead=true;spark(b.x,b.h,'#fff3c4',12,320);}
    else if(a.k==='bana'){if(b.k==='rock'||b.k==='arrow'){a.dead=true;b.dead=true;clang();spark(b.x,b.h,'#cfd6e6',8,240);}else{a.dead=true;spark(a.x,a.h,'#ffd27a',3,160);}}
    else if(light){b.dead=true;clang();spark(b.x,b.h,'#cfd6e6',10,280);}
    else if(b.k==='agni'&&a.k==='varuna'){b.dead=true;a.d*=1.5;cut(b.x,mh,'अग्नि शान्त · fire drowned');spark(b.x,mh,'#ffffff',26,300);noise(.6,.2,3000);}
    else if(b.k==='naga'&&a.k==='garuda'){for(const c of pr)if(c.o===1&&c.k==='naga'){c.dead=true;spark(c.x,c.h,'#8be06a',10,260);}a.d*=1.5;cut(b.x,mh,'गरुड़ ने सर्प निगले · serpents devoured');}
    else{a.dead=true;b.dead=true;clash(b.x,mh);}
    if(a.dead)break;}}
  // hits
  for(const q of pr){if(q.dead)continue;
    if(q.o===0){if(e.vanish||e.st==='ko')continue;
      if(Math.abs(q.x-e.x)<26*S+q.r*.5&&(q.k==='varuna'||q.k==='vayu'?e.z<200:(q.h>e.z-20&&q.h<e.z+215*S+30))){q.dead=true;const f=Math.sign(q.vx);
        if(q.k==='bana')dmgE(q.d,false,'bana');
        else if(q.k==='agni'){e.burn=3.5;boom(.2);ring(q.x,q.h,110,'255,130,40',.45);spark(q.x,q.h,'#ffb347',20,360);G.ef.push({k:'fire',o:0,x:e.x,t:0,dur:2.6,nt:0});dmgE(q.d,true,'agni');}
        else if(q.k==='varuna'){e.slow=3.5;e.burn=0;ring(q.x,60,120,'90,190,255',.45);spark(q.x,120,'#dff6ff',26,360);e.vx=f*260;dmgE(q.d,true,'varuna');}
        else if(q.k==='vayu'){e.vx=f*760;e.vz=420;e.z=Math.max(e.z,1);ring(q.x,q.h,110,'200,240,235');dmgE(q.d,true,'vayu',.8);}
        else if(q.k==='garuda'){e.vz=560;e.z=Math.max(e.z,1);ring(q.x,q.h,100,'255,214,120');spark(q.x,q.h,'#ffd27a',18,340);dmgE(q.d,true,'garuda',.7);}
        else if(q.k==='brahma'){G.flash=.9;G.flashC='255,250,235';G.shake=1.2;G.stop=.22;boom(.55);shankha(1.6);G.ef.push({k:'bblast',t:0,dur:1.7,x:e.x});
          ring(q.x,q.h,300,'255,244,214',1);ring(q.x,0,360,'255,200,90',1.1);spark(q.x,q.h,'#fff3c4',50,620);e.burn=3;dmgE(q.d,true,'brahma',1);}}
    }else{if(G.ph!=='fight')continue;
      const hit=q.k==='wave'?(Math.abs(q.x-p.x)<30&&p.z<38):(Math.abs(q.x-p.x)<22+q.r*.4&&q.h>p.z-12&&q.h<p.z+200);
      if(hit&&p.inv<=0){q.dead=true;const took=hitP(q.d,Math.sign(q.vx),q.x-Math.sign(q.vx)*40);
        if(took){if(q.k==='agni'){spark(p.x,140,'#ff8a1f',16,300);boom(.18);G.ef.push({k:'fire',o:1,x:p.x,t:0,dur:2.6,nt:.5});}
          if(q.k==='naga'){p.bound=2.8;G.pz=.3;float(p.x,260,'नागपाश → गरुड़','#8be06a',19,1);noise(.6,.12,5200);}}}}}
  G.pr=pr.filter(q=>!q.dead);
}
function updEf(dt){const p=P,e=E;
  for(const q of G.ef){q.t+=dt;
