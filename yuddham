    else{LT();dg(GL.red,X,Y,50*z,.9);line(X+14*z,Y-190*z,X+4*z,Y-60*z,'rgba(255,80,80,.5)',10*z);NT();line(X+10*z,Y-120*z,X,Y,'#2a1020',6*z);poly('#ffb0b0',[X-2*z,Y+26*z,X-12*z,Y-4*z,X+10*z,Y-6*z]);}}
  for(const q of G.ef){
    if(q.k==='pashu'&&q.t>=1){const X=sx(q.x),u=(q.t-1)/(q.dur-1),a=1-u,wd=(70+280*u)*z;LT();const g=K.createLinearGradient(X-wd,0,X+wd,0);g.addColorStop(0,'rgba(60,150,255,0)');g.addColorStop(.5,'rgba(200,235,255,'+a+')');g.addColorStop(1,'rgba(60,150,255,0)');K.fillStyle=g;K.fillRect(X-wd,0,wd*2,gy);
      dg(GL.blue,X,gy-60*z,(240+300*u)*z,a);dg(GL.white,X,gy-40*z,130*z,a);for(let i=0;i<8;i++)dg(GL.blue,X+(hs(i,3)-.5)*wd*1.4,gy-((t*500+i*90)%Math.max(60,gy)),(30+hs(i,8)*30)*z,a*.8);NT();}
    else if(q.k==='bblast'){const X=sx(q.x),u=q.t/q.dur,a=1-u,wd=(60+260*u)*z;LT();const g=K.createLinearGradient(X-wd,0,X+wd,0);g.addColorStop(0,'rgba(255,220,130,0)');g.addColorStop(.5,'rgba(255,252,240,'+a+')');g.addColorStop(1,'rgba(255,220,130,0)');K.fillStyle=g;K.fillRect(X-wd,0,wd*2,gy);
      dg(GL.white,X,gy-130*z,(160+900*u)*z,a);dg(GL.gold,X,gy-130*z,(300+1100*u)*z,a*.8);
      for(let i=0;i<4;i++){const uu=Math.max(0,u*1.5-i*.16);if(uu>0&&uu<1){K.strokeStyle='rgba(255,236,170,'+(1-uu)+')';K.lineWidth=12*z;K.beginPath();K.ellipse(X,gy,uu*900*z,uu*190*z,0,0,TAU);K.stroke();}}
      for(let i=0;i<12;i++){const b=i/12*TAU+u*2,rr=(60+u*460)*z;K.save();K.translate(X+Math.cos(b)*rr,gy-130*z+Math.sin(b)*rr);K.rotate(b);K.fillStyle='rgba(255,240,190,'+a+')';K.beginPath();K.ellipse(0,0,34*z,13*z,0,0,TAU);K.fill();K.restore();}
      K.globalAlpha=a;K.fillStyle='#fff';K.textAlign='center';K.font=Math.max(30,(120+200*u)*z)+'px "Yatra One",sans-serif';K.fillText('ॐ',X,gy-90*z);K.globalAlpha=1;NT();}}
  // Brahmastra gathering on the bow
  if(P.st==='cast'&&AS[P.ai].k==='brahma'&&P.t<P.rel){const u=P.t/P.rel,X=sx(P.x+P.face*96),Y=sy(P.z+150);LT();dg(GL.gold,X,Y,(60+200*u)*z,.9);dg(GL.white,X,Y,(20+70*u)*z,1);
    for(let i=0;i<4;i++){const v=((t*1.6+i/4)%1);K.strokeStyle='rgba(255,236,170,'+v+')';K.lineWidth=4*z;K.beginPath();K.arc(X,Y,(1-v)*300*z+10,0,TAU);K.stroke();}
    for(let i=0;i<14;i++){const b=i/14*TAU+t*2,rr=(1-((t*1.3+i*.07)%1))*320*z;dg(GL.white,X+Math.cos(b)*rr,Y+Math.sin(b)*rr,9*z,.9);}
    K.globalAlpha=u;K.fillStyle='#fff';K.textAlign='center';K.font=Math.max(18,70*z)+'px "Yatra One",sans-serif';K.fillText('ॐ',X,Y+24*z);K.globalAlpha=1;NT();}
}
function render(t){K=cx;K.setTransform(DPR,0,0,DPR,0,0);K.globalAlpha=1;NT();
  if(G.shake>0&&!RM){shx=(R()-.5)*G.shake*18;shy=(R()-.5)*G.shake*18;}else{shx=shy=0;}
  const z=sc*(1+G.zoomK);
  drawArena(t);
  if(G.dim>.01){K.fillStyle='rgba(4,6,22,'+G.dim+')';K.fillRect(0,0,W,H);}
  drawEfBack(t);
  drawFighter(E,t);drawFighter(P,t);
  // Tamasastra: the field goes dark, only his eyes and the astras show
  if(G.dark>0){const X=sx(P.x),Y=sy(120),a=.95*G.darkIn*Math.min(1,G.dark*1.5),g=K.createRadialGradient(X,Y,30*z,X,Y,Math.max(120,190*z));g.addColorStop(0,'rgba(3,0,8,0)');g.addColorStop(1,'rgba(3,0,8,'+a+')');K.fillStyle=g;K.fillRect(0,0,W,H);
    for(let i=0;i<9;i++){const xx=((hs(i,1)+t*.05*(i%2?1:-1))%1+1)%1*W,yy=H*(.15+hs(i,2)*.6)+Math.sin(t+i)*20;dg(GL.dark,xx,yy,m0()*.3,.5*G.darkIn);}
    if(!E.vanish){const S=E.def.scale*z,ex=sx(E.x)+E.face*16*S,ey=sy(E.z)-182*S;LT();dg(GL.red,ex,ey,34*S,1);dg(GL.red,ex+E.face*4*S,ey,12*S,1);if(E.def.heads)for(let i=1;i<=4;i++){dg(GL.red,ex-i*13*S,ey+i*2*S,16*S,.9);dg(GL.red,ex+i*13*S,ey,16*S,.9);}NT();}}
  drawPr(t);drawEfFront(t);
  // weather the astras bring
  if(G.rainT>0){const a=Math.min(1,G.rainT)*.4;K.strokeStyle='rgba(170,215,255,'+a+')';K.lineWidth=1.6;K.beginPath();for(let i=0;i<70;i++){const xx=((hs(i,1)+t*.25)%1)*(W+120)-60,yy=((hs(i,2)+t*(1.6+hs(i,3)))%1)*H;K.moveTo(xx,yy);K.lineTo(xx-10,yy+30);}K.stroke();}
  if(G.windT>0){const a=Math.min(1,G.windT)*.35,d=G.windDir;K.strokeStyle='rgba(235,255,250,'+a+')';K.lineWidth=2;K.beginPath();for(let i=0;i<22;i++){const xx=(((hs(i,5)+t*d*(1.2+hs(i,6)))%1)+1)%1*(W+300)-150,yy=hs(i,7)*groundY;K.moveTo(xx,yy);K.quadraticCurveTo(xx+d*60,yy-8,xx+d*130,yy+4);}K.stroke();}
  K.textAlign='center';
  for(const x of G.tx){K.globalAlpha=Math.min(1,x.l*2.5);const s=Math.max(13,x.s*Math.max(.85,sc*1.5));K.font=(x.f?'':'800 ')+s+'px '+(x.f?'"Yatra One",Mukta,sans-serif':'Mukta,system-ui,sans-serif');const hw=x.f?Math.min(W/2-8,x.v.length*s*.3+10):30,X=Math.max(hw,Math.min(W-hw,sx(x.x))),Y=Math.max(96,sy(x.h));
    K.lineWidth=4;K.strokeStyle='rgba(0,0,0,.8)';K.strokeText(x.v,X,Y);K.fillStyle=x.c;K.fillText(x.v,X,Y);}
  K.globalAlpha=1;
  const A=G.A;LT();for(const f of embers){const x=((f.x+t*.01*f.s)%1)*W,y=((f.y+1-(t*.03*f.s)%1)%1)*H;dg(GL[A.em]||GL.gold,x+Math.sin(t*f.s+f.p)*16,y,4+2*Math.sin(t*2+f.p),.35+.3*Math.sin(t*3+f.p));}NT();
  const vg=K.createRadialGradient(W/2,groundY-60,Math.min(W,H)*.4,W/2,groundY-60,Math.hypot(W,H)*.7);vg.addColorStop(0,'rgba(6,8,24,0)');vg.addColorStop(1,'rgba(6,8,24,.72)');K.fillStyle=vg;K.fillRect(0,0,W,H);
  if(state==='play'&&P.hp<P.max*.3&&G.ph==='fight'){const a=.16+.1*Math.sin(t*6);K.fillStyle='rgba(215,38,61,'+a+')';K.fillRect(0,0,W,6);K.fillRect(0,H-6,W,6);K.fillRect(0,0,6,H);K.fillRect(W-6,0,6,H);}
  if(G.flash>0){K.fillStyle='rgba('+G.flashC+','+Math.min(.85,G.flash*1.5)+')';K.fillRect(0,0,W,H);}
  if(state==='play'){const bx=joy.on?joy.ox:Math.max(78,W*.16),by=joy.on?joy.oy:H-96;K.strokeStyle='rgba(245,196,81,'+(joy.on?.5:.28)+')';K.lineWidth=2;K.beginPath();K.arc(bx,by,52,0,TAU);K.stroke();
    circ(bx+(joy.on?joy.x:0)*52,by+(joy.on?joy.y:0)*52,22,'rgba(245,196,81,'+(joy.on?.4:.18)+')');}
}
const m0=()=>Math.min(W,H);

/* ---------- HUD + screens ---------- */
const pad=$('pad');
AS.forEach((a,i)=>{const b=document.createElement('button');b.className='kb';b.id='as'+i;b.style.setProperty('--kc',a.c);b.setAttribute('aria-label',a.e);b.innerHTML='<span>'+a.s+'</span>';pad.appendChild(b);});
[['kD','वेग','#8fd0ff','Vega, dash'],['kS','खड्ग','#cfd6e6','Khadga, sword'],['kA','बाण','#f5c451','Bana, arrow']].forEach(q=>{const b=document.createElement('button');b.className='kb ready';b.id=q[0];b.style.setProperty('--kc',q[2]);b.setAttribute('aria-label',q[3]);b.innerHTML='<span>'+q[1]+'</span>';pad.appendChild(b);});
function setBtn(el,frac,ready){el.style.setProperty('--p',Math.max(0,Math.min(1,frac))*100+'%');el.classList.toggle('ready',ready);}
function hintIdx(){if(G.ph!=='fight')return -1;if(G.pr.some(q=>q.o===1&&q.k==='naga')||P.bound>0)return 3;if(G.pr.some(q=>q.o===1&&q.k==='agni'))return 1;
  if(E.st==='wind'&&EA[E.mv]&&EA[E.mv].c!==undefined&&E.mv!=='tamas'&&E.mv!=='megha')return EA[E.mv].c;if(G.dark>0)return 4;if(G.ef.some(q=>q.k==='megha'))return 2;return -1;}
function hud(){$('pH').style.width=Math.max(0,P.hp/P.max*100)+'%';$('eH').style.width=Math.max(0,E.hp/E.max*100)+'%';$('pT').style.width=G.tejas+'%';
  const s=Math.floor(G.ph==='intro'?0:G.t);$('clk').textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');
  const hi=hintIdx(),tf=1-Math.max(0,G.acd)/ACD;
  AS.forEach((a,i)=>{const el=$('as'+i),c=a.cost||0,ok=G.acd<=0&&G.tejas>=c;setBtn(el,Math.min(tf,c?G.tejas/c:1),ok);el.classList.toggle('hint',hi===i&&ok);});
  setBtn($('kD'),1-G.cdD/1,G.cdD<=0);setBtn($('kS'),1-G.cdS/.48,G.cdS<=0);}
function show(id){['menu','pause','end'].forEach(k=>$(k).hidden=k!==id);const play=state==='play'||state==='pause';$('hud').hidden=!play;pad.hidden=state!=='play';}
const fmt=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
function menu(){const box=$('foes');box.innerHTML='';if(sel>save.done)sel=Math.min(save.done,FOES.length-1);
  $('tier').textContent=save.tier?'वीर स्तर '+(save.tier+1)+' · every rakshasa is stronger and faster':'';
  FOES.forEach((D,i)=>{const b=document.createElement('button');b.className='fo'+(i===sel?' on':'');b.id='foe-'+i;b.disabled=i>save.done;const st=save.stars[i]||0;
    b.innerHTML='<div><b>'+D.n+' · '+D.e+'</b><em>'+(i>save.done?'Locked · defeat '+FOES[i-1].e+' first':D.tag)+'</em></div><i>'+(st?'★'.repeat(st)+'☆'.repeat(3-st)+(save.best[i]?'<br>'+fmt(save.best[i]):''):'')+'</i>';
    b.onclick=()=>{sel=i;newFight(sel);menu();};box.appendChild(b);});}
function startFight(){initAudio();newFight(sel);state='play';last=performance.now();$('eN').textContent=G.D.n;show(null);hud();}
function endFight(){state='end';const win=G.win,D=G.D,i=G.i,hpf=P.hp/P.max;let up=false;
  if(win){const st=1+(hpf>=.35?1:0)+(hpf>=.65?1:0);if(st>(save.stars[i]||0))save.stars[i]=st;if(save.done<=i)save.done=i+1;if(!save.best[i]||G.t<save.best[i])save.best[i]=Math.round(G.t);
    if(i===FOES.length-1&&save.tier<5){save.tier++;up=true;}persist();}
  $('eEye').textContent=G.A.nm+' · '+D.e;
  $('eH2').textContent=win?'विजय · जय श्री राम':'फिर उठो, राघव';
  $('eP').textContent=win?D.win+(up?' A harder war now opens: वीर स्तर '+(save.tier+1)+'.':''):'Rama withdraws for a moment, and '+D.e+' roars. Keep one astra ready to answer his: the flashing button is the answer. Guard, dash or jump the rest.';
  $('sT').textContent=fmt(G.t);$('sC').textContent=G.cuts;$('sH').textContent=Math.round(hpf*100)+'%';
  const nx=win&&i<FOES.length-1;$('bNext').textContent=nx?'Next · '+FOES[i+1].n+' '+FOES[i+1].e:(win?'जय श्री राम · Fight again':'जय श्री राम · Rise and fight');
  $('bNext').onclick=()=>{if(nx)sel=i+1;startFight();};
  if(win)bell();show('end');}
function toMenu(){state='menu';newFight(sel);menu();show('menu');}
function pause(){if(state!=='play')return;state='pause';joy.on=false;hold.arrow=false;show('pause');}
function resume(){if(state!=='pause')return;state='play';last=performance.now();show(null);}

/* ---------- input ---------- */
cv.addEventListener('pointerdown',e=>{if(state!=='play')return;joy.on=true;joy.id=e.pointerId;joy.ox=e.clientX;joy.oy=e.clientY;joy.x=joy.y=0;try{cv.setPointerCapture(e.pointerId);}catch(_){}});
cv.addEventListener('pointermove',e=>{if(!joy.on||e.pointerId!==joy.id)return;let dx=e.clientX-joy.ox,dy=e.clientY-joy.oy;const l=Math.hypot(dx,dy),M=52;
  if(l>M){joy.ox+=dx*(1-M/l);joy.oy+=dy*(1-M/l);dx=dx/l*M;dy=dy/l*M;}joy.x=dx/M;joy.y=dy/M;});
const jEnd=e=>{if(e.pointerId===joy.id){joy.on=false;joy.x=joy.y=0;}};cv.addEventListener('pointerup',jEnd);cv.addEventListener('pointercancel',jEnd);
cv.addEventListener('contextmenu',e=>e.preventDefault());
const tap=(id,fn)=>$(id).addEventListener('pointerdown',e=>{e.preventDefault();fn();});
AS.forEach((a,i)=>tap('as'+i,()=>want('astra',i)));tap('kD',()=>want('dash'));tap('kS',()=>want('sword'));
const kA=$('kA');kA.addEventListener('pointerdown',e=>{e.preventDefault();hold.arrow=true;try{kA.setPointerCapture(e.pointerId);}catch(_){}});
['pointerup','pointercancel','lostpointercapture'].forEach(n=>kA.addEventListener(n,()=>{hold.arrow=false;}));
addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(!keys[k]&&state==='play'){if(k==='k')want('sword');else if(k==='l'||k==='shift')want('dash');else if(k===' ')jump();else if(k.length===1&&k>='1'&&k<='9')want('astra',+k-1);}
  keys[k]=true;if(state==='play'&&(k===' '||k.startsWith('arrow')))e.preventDefault();
  if(k==='escape'||k==='p'){if(state==='play')pause();else if(state==='pause')resume();}});
addEventListener('keyup',e=>{keys[e.key.toLowerCase()]=false;});
addEventListener('blur',()=>{for(const k in keys)keys[k]=false;hold.arrow=false;});
document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});
$('bPlay').onclick=startFight;$('bHome').onclick=toMenu;$('bQuit').onclick=toMenu;$('bResume').onclick=resume;$('bPause').onclick=pause;
$('bSnd').onclick=()=>{soundOn=!soundOn;$('bSnd').style.opacity=soundOn?1:.4;if(master)master.gain.value=soundOn?.6:0;if(!soundOn){try{speechSynthesis.cancel();}catch(e){}}};

/* ---------- loop ---------- */
function frame(now){const dt=Math.min(.033,(now-last)/1000||0);last=now;
  if(state==='play'){update(dt);if(state==='play')hud();}
  else{poseStep(P,dt);poseStep(E,dt);const ts=Math.min(W/760,(groundY-78)/Math.max(245,E.def.scale*222));sc+=(ts-sc)*Math.min(1,dt*4);cam+=(0-cam)*Math.min(1,dt*4);}
  render(now/1000);requestAnimationFrame(frame);}
resize();sel=Math.min(save.done,FOES.length-1);newFight(sel);menu();show('menu');requestAnimationFrame(frame);
window.__dy={G:()=>G,P:()=>P,E:()=>E,state:()=>state,start:i=>{sel=i;startFight();},update,render,hud,want,jump,hold,keys,release,onAct,AS};
})();
