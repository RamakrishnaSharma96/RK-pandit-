        if(!e.vanish)dmgE(q.d,true,'surya',1.3);tone(880,.8,'sine',.1,1760);}break;
      case 'vajra':{const n=q.t>=.78?3:q.t>=.58?2:q.t>=.38?1:0;while(q.n<n){q.n++;bolt(e.x+(R()-.5)*30,130*e.def.scale+e.z,700);G.flash=.24;G.flashC='200,190,255';noise(.4,.2,1500);boom(.22);if(!e.vanish)dmgE(q.d/3,q.n===3,'vajra');}break;}
      case 'nara':q.nt-=dt;if(q.nt<=0&&q.t<q.dur-.25){q.nt=.18;q.n++;sfx(()=>tone(900,.06,'triangle',.04,400));for(let i=0;i<7;i++)G.fx.push({k:5,x:e.x+(R()-.5)*280,l:.24,ml:.24});
        if(!e.vanish)dmgE(q.d/11,q.n%4===0,'narayana');}break;
      case 'pashu':if(q.t<.8)q.x=e.x;if(q.b<4&&q.t>=q.b*.2){q.b++;tone(115,.16,'sine',.28,70);noise(.05,.16,320);}
        if(!q.done&&q.t>=1){q.done=true;G.shake=1;boom(.5);G.flash=.55;G.flashC='127,208,255';G.stop=.14;ring(q.x,0,260,'127,208,255',.8);ring(q.x,0,160,'220,240,255',.6);spark(q.x,60,'#bfe8ff',40,480);
          if(Math.abs(e.x-q.x)<180&&!e.vanish){e.burn=2.5;dmgE(q.d,true,'pashupata',.9);}}break;
      case 'megha':q.x+=(p.x-q.x)*Math.min(1,dt*1.5);q.nt-=dt;if(q.nt<=.4&&!q.lock){q.lock=true;q.lx=q.x;}
        if(q.nt<=0){q.nt=.82;q.lock=false;bolt(q.lx,0,430);noise(.3,.18,1500);G.flash=.12;G.flashC='200,190,255';ring(q.lx,0,60,'200,190,255',.3);if(Math.abs(p.x-q.lx)<46&&p.z<140)hitP(q.d,0,p.x+p.face);}break;
      case 'rain':q.nt-=dt;if(q.nt<=0&&q.t<q.dur-.7){q.nt=.42;G.strikes.push({x:Math.max(-ARW,Math.min(ARW,p.x+(R()-.5)*100)),l:.78,ml:.78,rock:q.rock,d:q.d});}break;
      case 'fire':if(q.o===1&&G.ph==='fight'){q.nt-=dt;if(q.nt<=0){q.nt=.5;if(Math.abs(p.x-q.x)<54&&p.z<20){p.hp-=5*G.dm;p.flash=.08;float(p.x,230,'आग','#ff8a6a',14);if(p.hp<=0){p.hp=0;koP();}}}}break;
    }}
  G.ef=G.ef.filter(q=>q.t<q.dur);
  for(let i=G.strikes.length-1;i>=0;i--){const q=G.strikes[i];q.l-=dt;if(q.l<=0){G.strikes.splice(i,1);G.shake=Math.max(G.shake,.25);sfx(()=>boom(.18));ring(q.x,0,70,q.rock?'200,170,130':'255,80,80',.3);spark(q.x,20,q.rock?'#9aa0aa':'#ff8a6a',10,280);
    if(Math.abs(p.x-q.x)<54&&p.z<130)hitP(q.d,0,p.x+p.face);}}
