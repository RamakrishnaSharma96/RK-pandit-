function updP(dt){const p=P;p.t+=dt;p.inv-=dt;if(p.flash>0)p.flash-=dt;
  G.cdA-=dt;G.cdS-=dt;G.cdD-=dt;if(G.acd>0)G.acd-=dt;
  if(G.want){G.want.t-=dt;if(G.want.t<=0)G.want=null;}
  let mx=joy.on?joy.x:0;if(keys.a||keys.arrowleft)mx-=1;if(keys.d||keys.arrowright)mx+=1;mx=Math.max(-1,Math.min(1,mx));
  const up=(joy.on&&joy.y<-.6)||keys.w||keys.arrowup,down=(joy.on&&joy.y>.6)||keys.s||keys.arrowdown;
  if(!up)G.jumpArm=true;
  const fight=G.ph==='fight',spd=(p.slow>0?.5:1)*(p.bound>0?.3:1);p.moving=false;
  if(p.bound>0){p.bound-=dt;G.pz-=dt;if(G.pz<=0&&fight){G.pz=.5;p.hp-=3*G.dm;float(p.x,235,'विष','#8be06a',14);if(p.hp<=0){p.hp=0;koP();}}}
  if(fight&&(p.st==='idle'||p.st==='guard')){
    p.face=E.x>=p.x?1:-1;
    p.st=(down&&p.z===0)?'guard':'idle';
    if(p.st==='idle'&&Math.abs(mx)>.15){p.x+=mx*280*spd*dt;p.moving=true;p.mdir=Math.sign(mx)*p.face;p.walk+=dt;}
    if(up&&G.jumpArm){G.jumpArm=false;jump();}
    const w=G.want;
    if(w){
      if(w.n==='sword'&&G.cdS<=0){p.st='slash';p.t=0;p.did=false;G.cdS=.48;G.want=null;sfx(()=>noise(.18,.16,2400));}
      else if(w.n==='dash'&&G.cdD<=0&&p.bound<=0){p.st='dash';p.t=0;p.inv=.32;G.cdD=1;p.dd=Math.abs(mx)>.2?Math.sign(mx):p.face;G.want=null;sfx(()=>noise(.2,.12,1500));}
      else if(w.n==='astra'){const a=AS[w.i],c=a.cost||0;if(G.acd<=0&&G.tejas>=c){G.tejas-=c;G.acd=ACD;p.st='cast';p.t=0;p.rel=a.k==='brahma'?.7:c?.5:.32;p.did=false;p.ai=w.i;p.sky=!!a.sky;announce(a);G.want=null;}}
    }
    if(p.st==='idle'&&(hold.arrow||keys.j)&&G.cdA<=0){p.st='shoot';p.t=0;p.rel=.12;p.did=false;G.cdA=.36;}
  }else if(p.st==='shoot'){
    if(fight&&Math.abs(mx)>.15){p.x+=mx*140*spd*dt;p.moving=true;p.mdir=Math.sign(mx)*p.face;p.walk+=dt;}
    if(!p.did&&p.t>=p.rel){p.did=true;G.pr.push({o:0,k:'bana',x:p.x+p.face*84,h:p.z+150,vx:p.face*1000,vh:0,d:9,r:10});sfx(()=>tone(720,.07,'triangle',.05,360));}
    if(p.t>=.26)p.st='idle';
  }else if(p.st==='cast'){
    if(!p.did&&p.t>=p.rel){p.did=true;release(AS[p.ai]);}
    if(p.t>=p.rel+.3)p.st='idle';
  }else if(p.st==='slash'){
    p.x+=p.face*90*dt;
    if(!p.did&&p.t>=.13){p.did=true;const dx=(E.x-p.x)*p.face;
      if(dx>-20&&dx<110+34*E.def.scale&&!E.vanish&&E.z<120){dmgE(34,true,'sword');E.vx=p.face*240;}
      for(const q of G.pr){if(q.o===1&&q.k!=='wave'){const d2=(q.x-p.x)*p.face;if(d2>-10&&d2<130){q.dead=true;spark(q.x,q.h,'#fff3c4',8,260);clang();G.tejas=Math.min(100,G.tejas+4);float(q.x,q.h+40,'काट!','#fff3c4',18,1);}}}}
    if(p.t>=.34)p.st='idle';
  }else if(p.st==='dash'){p.x+=p.dd*900*dt;if(p.t>=.2)p.st='idle';}
  else if(p.st==='hit'){if(p.t>=.3)p.st='idle';}
  if(p.slow>0)p.slow-=dt;
  p.x+=p.vx*dt;p.vx-=p.vx*Math.min(1,dt*8);
  if(p.z>0){p.vz-=1950*dt;p.z+=p.vz*dt;if(p.z<=0){p.z=0;p.vz=0;}}
